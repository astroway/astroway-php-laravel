{
  "name": "astroway/sdk-laravel",
  "description": "Laravel ServiceProvider + facade for astroway/sdk — astroway() helper, config publishing, env-driven setup.",
  "type": "library",
  "keywords": ["astrology", "api", "sdk", "laravel", "facade", "astroway"],
  "license": "MIT",
  "homepage": "https://api.astroway.info/docs/",
  "authors": [{ "name": "AstroWay", "email": "astroway.info@gmail.com" }],
  "support": {
    "issues": "https://github.com/astroway/astroway-php-laravel/issues",
    "source": "https://github.com/astroway/astroway-php-laravel"
  },
  "require": {
    "php": "^8.1",
    "astroway/sdk": ">=0.1.0-alpha.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/contracts": "^10.0 || ^11.0 || ^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "guzzlehttp/guzzle": "^7.8",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": { "Astroway\\Laravel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Astroway\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Astroway\\Laravel\\AstrowayServiceProvider"],
      "aliases": { "Astroway": "Astroway\\Laravel\\Facades\\Astroway" }
    }
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "config": { "sort-packages": true }
}
